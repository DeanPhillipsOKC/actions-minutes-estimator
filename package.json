  "scripts": { "test": "node --test \"test/*.test.mjs\"" },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "author": "Dean Phillips",
  "repository": { "type": "git", "url": "git+https://github.com/DeanPhillipsOKC/actions-minutes-estimator.git" },
  "keywords": ["github-actions", "billing", "minutes", "budget"]
}
